{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/dog.txt",
        "color": { "1": "white" },
    },
    "display": {
        "color": { "keys": "blue", "title": "blue" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "key": "Disk" },
        { "type": "localip", "key": "Local IP" }
    ]
}
